# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# Secrets — never commit. The headless profile reads <cwd>/.env, so keys must
# never live in this repository, ignored or not.
.env
.env.*
!.env.example

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Claude Code local settings and temporary files
.claude/

# Ghost exports and local backups — contain credentials
ghost-export.json
ghost-import.json
backup/

# Desk éditorial — textes intégraux capturés (droits d'auteur), restent en local
editorial/sources/*/text.txt

.desk/

# Temporary desk extracts
.tmp-piece/

# Local DSH home used by the desk agent (contains credentials)
.dsh-home/

# Style corpus — textes sous droits, capturés localement
editorial/style/corpus/

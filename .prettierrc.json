{
  "plugins": ["prettier-plugin-astro"],
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "trailingComma": "all",
  "overrides": [
    {
      "files": "*.astro",
      "options": {
        "parser": "astro",
        "useTabs": true,
        "singleQuote": false
      }
    }
  ]
}

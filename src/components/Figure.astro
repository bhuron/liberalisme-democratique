---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	src: ImageMetadata | string;
	alt: string;
	caption: string;
	source?: string;
	sourceUrl?: string;
}

const { src, alt, caption, source, sourceUrl } = Astro.props;
const optimized = typeof src === "string" ? null : src;
const plain = typeof src === "string" ? src : null;
---

<figure class="my-10">
	{optimized ? (
		<Image
			src={optimized}
			alt={alt}
			class="mx-auto w-full rounded-lg border border-gray-200 bg-white"
			loading="lazy"
			decoding="async"
		/>
	) : (
		<img
			src={plain ?? ""}
			alt={alt}
			class="mx-auto w-full rounded-lg border border-gray-200 bg-white"
			loading="lazy"
			decoding="async"
		/>
	)}
	<figcaption class="mx-auto mt-3 max-w-2xl text-center text-sm leading-relaxed text-gray-500">
		<span class="block">{caption}</span>
		{source && (
			<span class="mt-1 block text-xs text-gray-400">
				{sourceUrl ? (
					<a
						href={sourceUrl}
						class="no-underline decoration-gray-300 underline-offset-2 hover:text-gray-600 hover:underline"
						target="_blank"
						rel="noopener noreferrer"
					>
						{source}
					</a>
				) : (
					source
				)}
			</span>
		)}
	</figcaption>
</figure>

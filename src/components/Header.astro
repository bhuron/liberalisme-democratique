---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
---

<header class="bg-white/80 backdrop-blur-sm border-b border-gray-200/60 px-4 py-5 sm:px-6 md:px-8">
	<a
		href="#main"
		class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-accent focus:shadow-lg"
	>
		Aller au contenu
	</a>
	<nav
		aria-label="Navigation principale"
		class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-4"
	>
		<p class="m-0 text-xl sm:text-2xl font-display font-bold tracking-tight">
			<a
				href="/"
				class="text-gray-900 no-underline hover:text-accent transition-colors duration-200"
			>
				{SITE_TITLE}
			</a>
		</p>
		<div class="internal-links flex items-center gap-1 sm:gap-2">
			<HeaderLink href="/">Accueil</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">À propos</HeaderLink>
		</div>
	</nav>
</header>

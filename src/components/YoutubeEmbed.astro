---
interface Props {
	url: string;
	title?: string;
	caption?: string;
	source?: string;
	sourceUrl?: string;
}

const {
	url,
	title = "Lecteur vidéo YouTube",
	caption,
	source,
	sourceUrl,
} = Astro.props;

function getYouTubeId(value: string): string | null {
	try {
		const parsed = new URL(value);

		if (parsed.hostname === "youtu.be") {
			return parsed.pathname.split("/").filter(Boolean)[0] ?? null;
		}

		const isYouTube =
			parsed.hostname === "youtube.com" ||
			parsed.hostname.endsWith(".youtube.com") ||
			parsed.hostname === "youtube-nocookie.com" ||
			parsed.hostname.endsWith(".youtube-nocookie.com");

		if (!isYouTube) {
			return null;
		}

		if (parsed.pathname === "/watch") {
			return parsed.searchParams.get("v");
		}

		const match = parsed.pathname.match(/^\/(?:embed|shorts|live)\/([^/?#]+)/);
		return match?.[1] ?? null;
	} catch {
		return null;
	}
}

const videoId = getYouTubeId(url);
---

{videoId ? (
	<figure class="my-10">
		<div class="relative aspect-video w-full overflow-hidden rounded-lg border border-gray-200 bg-black">
			<iframe
				src={`https://www.youtube-nocookie.com/embed/${videoId}`}
				title={title}
				loading="lazy"
				allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
				referrerpolicy="strict-origin-when-cross-origin"
				allowfullscreen
				class="absolute inset-0 h-full w-full border-0"
			/>
		</div>
		{(caption || source) && (
			<figcaption class="mx-auto mt-3 max-w-2xl text-center text-sm leading-relaxed text-gray-500">
				{caption && <span class="block">{caption}</span>}
				{source && (
					<span class="mt-1 block text-xs text-gray-400">
						{sourceUrl ? (
							<a
								href={sourceUrl}
								class="no-underline decoration-gray-300 underline-offset-2 hover:text-gray-600 hover:underline"
								target="_blank"
								rel="noopener noreferrer"
							>
								{source}
							</a>
						) : (
							source
						)}
					</span>
				)}
			</figcaption>
		)}
	</figure>
) : (
	<p class="my-6 text-sm italic text-gray-500">URL YouTube invalide.</p>
)}

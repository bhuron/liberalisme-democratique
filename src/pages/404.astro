---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead
			title={`Page introuvable - ${SITE_TITLE}`}
			description="La page demandée n'existe pas ou a été déplacée."
		/>
		<meta name="robots" content="noindex" />
	</head>
	<body class="min-h-screen">
		<Header />
		<main id="main" class="max-w-4xl mx-auto px-4 py-24 text-center">
			<p class="text-sm font-semibold uppercase tracking-wider text-accent mb-4">
				Erreur 404
			</p>
			<h1 class="text-4xl md:text-5xl font-extrabold text-black mb-6">
				Page introuvable
			</h1>
			<p class="text-lg text-gray-600 mb-10">
				La page que vous cherchez n'existe pas ou a été déplacée.
			</p>
			<div class="flex flex-wrap justify-center gap-4">
				<a
					href="/"
					class="inline-flex items-center rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-white no-underline hover:bg-accent-dark transition-colors duration-200"
				>
					Retour à l'accueil
				</a>
				<a
					href="/blog/"
					class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-5 py-3 text-sm font-semibold text-gray-800 no-underline hover:border-accent hover:text-accent transition-colors duration-200"
				>
					Voir les articles
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
